# ATC Recorder Environment Configuration
# Copy this file to .env and customize as needed

# Timezone for timestamps (default: UTC)
TZ=UTC

# Log level: DEBUG, INFO, WARNING, ERROR
ATC_LOG_LEVEL=INFO

# Docker Compose project name (optional)
COMPOSE_PROJECT_NAME=atc-recorder

# =============================================================================
# NVIDIA Whisper ASR Configuration (for --profile asr)
# =============================================================================

# NGC API Key for NVIDIA NIM (required for ASR)
# Get your key at: https://build.nvidia.com/openai/whisper-large-v3
NGC_API_KEY=

# Whisper gRPC service settings (defaults, usually don't need to change)
# WHISPER_GRPC_HOST=whisper-asr
# WHISPER_GRPC_PORT=50051

# =============================================================================
# NVIDIA NIM Retriever Configuration (for --profile rag / --profile retriever)
# =============================================================================

# Retriever reuses NGC_API_KEY (same credential as Whisper ASR).
# No separate API key is required.

# Retriever container image and port mapping.
# Override if you pin a different NIM Retriever build.
NIM_RETRIEVER_IMAGE=nvcr.io/nim/nvidia/llama-3.2-nv-embedqa-1b-v2:latest
NIM_RETRIEVER_HTTP_PORT=8000
NIM_RETRIEVER_HOST_PORT=9080

# Optional model selector inside the Retriever container.
# Default aligns with the model used in config.yaml examples.
NIM_RETRIEVER_TAGS_SELECTOR=name=llama-3.2-nv-embedqa-1b-v2
